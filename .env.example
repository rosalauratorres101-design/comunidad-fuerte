# Copy this file to .env and fill in the keys you have. Leave a line empty to
# keep that service in demo/simulated mode.

# Claude (Anthropic) — live AI
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional
PORT=3000
# Hours between automatic knowledge updates (live AI only). 0 turns it off.
KNOWLEDGE_REFRESH_HOURS=24
# Minimum AI confidence before the tier is moved up one level / payout goes to human review
AI_CONFIDENCE_FLOOR=0.6
MAX_PAYOUT_PER_MILESTONE=2000
# Secret for signed photo links (any long random text). If empty, one is created in data/private.
MEDIA_LINK_SECRET=
# On a public server set to false so nobody can erase all records.
ALLOW_RESET=true
